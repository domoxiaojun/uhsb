# 镜像来源：默认本地构建，改成 GHCR 地址即可直接拉现成镜像
# CFTEST_IMAGE=ghcr.io/domoxiaojun/uhsb:latest
CFTEST_IMAGE=cftest:local

# 容器使用 host 网络（IPv4/IPv6 都可用），监听地址直接由 CFWEB_ADDR 决定。
# 默认只监听回环；需局域网访问时改成 0.0.0.0:8787，并把 CFWEB_ALLOW 收紧。
CFWEB_ADDR=127.0.0.1:8787
# 镜像以非 root 运行；Linux 上把这两个值设为 ./data 的属主
# （或执行 sudo chown -R 10001:10001 data）
CFWEB_UID=10001
CFWEB_GID=10001
# 用自定义域名访问时，把域名填入 Host 白名单（逗号分隔），否则会被 403
# CFWEB_HOSTS=cf.example.com
# 默认禁止经 Web 下载含 UUID 的节点产物；确需下载时才打开
CFWEB_EXPOSE_CREDENTIALS=false

CFWEB_OPEN=false
CFWEB_ROOT=/data
# 允许访问的来源：lan(默认，回环+私有网段+本机网卡) | private | any | CIDR 列表
CFWEB_ALLOW=lan
# cfscan 路由关键字（逗号分隔；默认港台，扫 NRT/SIN 可改成 nrt,sin）
CFSCAN_KEYWORDS=hkg,tpe,tw,hk

# Optional: fill these to auto-enable VMess+WS speed tests
VMESS_UUID=
VMESS_HOST=
VMESS_PATH=/
VMESS_SNI=
VMESS_PORT=443
VMESS_TLS=true
# 自签证书节点才开；公网节点请保持 false
VMESS_ALLOW_INSECURE=false
